# Copia este archivo como ".env" para cambiar la configuración (todo tiene un valor por defecto que funciona).
DB_NAME=king_tokky
DB_USER=kingtokky
DB_PASSWORD=kingtokky
DB_PORT=5433

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Cámbiala fuera de desarrollo.
JWT_SECRETO=king-tokky-clave-de-desarrollo-cambiar-en-produccion-2026

# Dónde corre el frontend Angular (CORS y enlaces de los correos)
FRONTEND_URL=http://localhost:4200
CORS_ORIGENES=http://localhost:4200,http://127.0.0.1:4200

# URL pública del backend (para armar los enlaces de las fotos de perfil)
URL_PUBLICA_BASE=http://localhost:8080

# "Iniciar sesión con Google": ID de cliente OAuth de tu proyecto en Google Cloud (opcional)
GOOGLE_CLIENT_ID=
